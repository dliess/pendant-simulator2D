{% doc %}
  Interactive fluid pendant theme block. Settings are read from block.settings.
  @example
  Add Pendant simulator to an existing section that accepts @theme blocks.
{% enddoc %}

<pendant-simulator
  data-display-mode="{{ block.settings.display_mode | default: 'simulator' | escape }}"
  data-photo-version="{% if block.settings.pendant_photo != blank %}{{ block.settings.pendant_photo | image_url: width: 2400 | escape }}{% endif %}"
  data-photo-center-x="{{ block.settings.photo_center_x | default: 50 }}"
  data-photo-center-y="{{ block.settings.photo_center_y | default: 60 }}"
  data-photo-diameter="{{ block.settings.photo_diameter | default: 30 }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-show-heading="{{ block.settings.show_heading }}"
  data-show-motion-controls="{{ block.settings.show_motion_controls }}"
  data-transparent-background="{{ block.settings.transparent_background }}"
  data-background-color="{{ block.settings.background_color | default: '#101820' | escape }}"
  data-text-color="{{ block.settings.text_color | default: '#ffffff' | escape }}"
  data-display-width="{{ block.settings.display_width }}"
  data-size-mode="{{ block.settings.size_mode | default: 'fixed' | escape }}"
  data-container-padding="{{ block.settings.container_padding | default: 4 }}"
  data-vertical-offset="{{ block.settings.vertical_offset | default: 0 }}"
  data-show-housing="{{ block.settings.show_housing }}"
  data-led-color="{{ block.settings.led_color | default: 'blue' | escape }}"
  data-radius-scale="{{ block.settings.radius_scale | default: 100 }}"
  data-particle-count="{{ block.settings.particle_count }}"
  data-fill-level="{{ block.settings.fill_level }}"
  data-gravity-strength="{{ block.settings.gravity_strength }}"
  data-react-to-scrolling="{{ block.settings.react_to_scrolling }}"
  {{ block.shopify_attributes }}
>
  <template data-pendant-simulator-photo>
    {% if block.settings.pendant_photo != blank %}
      {{ block.settings.pendant_photo | image_url: width: 2400 | image_tag: widths: '320, 480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'lazy' }}
    {% endif %}
  </template>
  <template data-pendant-simulator-assets>
    <link rel="stylesheet" href="{{ 'pendant-simulator.css' | asset_url }}">
    <script src="{{ 'pendant-simulator.js' | asset_url }}" defer></script>
  </template>
</pendant-simulator>

{% javascript %}
  // Shopify delivers this hook once per block file in its external block-scripts
  // bundle. Inert templates let repeated blocks share one real CSS/JS load.
  const loaderKey = Symbol.for('pendant-simulator.asset-loader');
  if (!window[loaderKey]) {
    window[loaderKey] = true;
    const loaded = new Set();

    function loadAssets(root) {
      const templates = root.matches?.('template[data-pendant-simulator-assets]')
        ? [root] : root.querySelectorAll('template[data-pendant-simulator-assets]');
      for (const template of templates) {
        for (const tag of template.content.querySelectorAll('link[href], script[src]')) {
          const isScript = tag.tagName === 'SCRIPT';
          const attribute = isScript ? 'src' : 'href';
          const url = new URL(tag.getAttribute(attribute), document.baseURI).href;
          const key = `${tag.tagName}:${url}`;
          if (loaded.has(key)) continue;
          loaded.add(key);
          const existing = Array.from(document.head.querySelectorAll(isScript ? 'script[src]' : 'link[rel="stylesheet"]'))
            .some(asset => asset[attribute] === url);
          if (existing) continue;
          const asset = document.createElement(isScript ? 'script' : 'link');
          asset[attribute] = url;
          asset.dataset.pendantSimulatorAsset = isScript ? 'script' : 'style';
          if (isScript) asset.defer = true;
          else asset.rel = 'stylesheet';
          asset.addEventListener('error', () => { loaded.delete(key); asset.remove(); }, { once: true });
          document.head.append(asset);
        }
      }
    }

    loadAssets(document);
    new MutationObserver(records => {
      for (const record of records) {
        for (const node of record.addedNodes) {
          if (node instanceof Element) loadAssets(node);
        }
      }
    }).observe(document.documentElement, { childList: true, subtree: true });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Pendant simulator",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        { "value": "simulator", "label": "Simulator only" },
        { "value": "photo", "label": "Overlay on pendant photo" }
      ],
      "default": "simulator"
    },
    {
      "type": "image_picker",
      "id": "pendant_photo",
      "label": "Pendant photo",
      "info": "Choose the photo here instead of using a group background. The full image and display scale together without cropping. Without a photo, the normal simulator is shown.",
      "visible_if": "{{ block.settings.display_mode == 'photo' }}"
    },
    {
      "type": "range",
      "id": "photo_center_x",
      "label": "Display center from left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "Percentage of the photo's width.",
      "visible_if": "{{ block.settings.display_mode == 'photo' }}"
    },
    {
      "type": "range",
      "id": "photo_center_y",
      "label": "Display center from top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 60,
      "info": "Percentage of the photo's height.",
      "visible_if": "{{ block.settings.display_mode == 'photo' }}"
    },
    {
      "type": "range",
      "id": "photo_diameter",
      "label": "Display diameter",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30,
      "info": "Visible LED display diameter as a percentage of the photo's width. Adjust once to match the photograph; alignment is preserved on smaller screens.",
      "visible_if": "{{ block.settings.display_mode == 'photo' }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try the pendant"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_motion_controls",
      "label": "Show phone motion controls",
      "default": true,
      "info": "When off, phone motion starts automatically. Some browsers require tapping the pendant to allow access."
    },
    {
      "type": "checkbox",
      "id": "transparent_background",
      "label": "Transparent background",
      "default": false,
      "info": "Makes the block and the area outside the circular pendant transparent."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#101820",
      "info": "Used when Transparent background is off."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff",
      "info": "Choose a contrasting color for the heading, instructions, and status."
    },
    {
      "type": "checkbox",
      "id": "show_housing",
      "label": "Show gray housing",
      "default": true,
      "info": "Turn off to make the gray ring transparent. The dark LED display stays visible.",
      "visible_if": "{{ block.settings.display_mode != 'photo' }}"
    },
    {
      "type": "select",
      "id": "led_color",
      "label": "LED color",
      "options": [
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" }
      ],
      "default": "blue"
    },
    {
      "type": "select",
      "id": "size_mode",
      "label": "Size mode",
      "options": [
        { "value": "fixed", "label": "Set display size" },
        { "value": "container", "label": "Adapt to container" }
      ],
      "default": "fixed",
      "visible_if": "{{ block.settings.display_mode != 'photo' }}"
    },
    {
      "type": "range",
      "id": "container_padding",
      "label": "Container padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 4,
      "info": "Padding on each side as a percentage of the block's width. The pendant fills the remaining width.",
      "visible_if": "{{ block.settings.display_mode != 'photo' and block.settings.size_mode == 'container' }}"
    },
    {
      "type": "range",
      "id": "vertical_offset",
      "label": "Vertical center offset",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "%",
      "default": 0,
      "info": "Percentage of the simulator block's height. Negative moves up; positive moves down. Heading and controls stay in place.",
      "visible_if": "{{ block.settings.display_mode != 'photo' }}"
    },
    {
      "type": "range",
      "id": "display_width",
      "label": "Maximum display width",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 400,
      "visible_if": "{{ block.settings.display_mode != 'photo' and block.settings.size_mode != 'container' }}"
    },
    {
      "type": "range",
      "id": "radius_scale",
      "label": "Pendant radius",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales the pendant relative to Maximum display width. Shrinks to fit smaller screens.",
      "visible_if": "{{ block.settings.display_mode != 'photo' and block.settings.size_mode != 'container' }}"
    },
    {
      "type": "range",
      "id": "fill_level",
      "label": "Initial fill height",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "select",
      "id": "particle_count",
      "label": "Particle count",
      "options": [
        { "value": "500", "label": "500" },
        { "value": "1000", "label": "1,000" },
        { "value": "1500", "label": "1,500" },
        { "value": "2000", "label": "2,000" },
        { "value": "2500", "label": "2,500" },
        { "value": "3000", "label": "3,000" },
        { "value": "3500", "label": "3,500" },
        { "value": "4000", "label": "4,000" },
        { "value": "4500", "label": "4,500" },
        { "value": "5000", "label": "5,000" },
        { "value": "5500", "label": "5,500" },
        { "value": "6000", "label": "6,000" },
        { "value": "6500", "label": "6,500" },
        { "value": "7000", "label": "7,000" },
        { "value": "7500", "label": "7,500" },
        { "value": "8000", "label": "8,000" },
        { "value": "8500", "label": "8,500" },
        { "value": "9000", "label": "9,000" },
        { "value": "9500", "label": "9,500" },
        { "value": "10000", "label": "10,000" }
      ],
      "default": "2000",
      "info": "Lower counts reduce simulation work on mobile devices."
    },
    {
      "type": "range",
      "id": "gravity_strength",
      "label": "Gravity strength",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "react_to_scrolling",
      "label": "React to scrolling",
      "default": true,
      "info": "Give the liquid inertia when scrolling starts, stops, or changes direction."
    }
  ],
  "presets": [{ "name": "Pendant simulator" }]
}
{% endschema %}
