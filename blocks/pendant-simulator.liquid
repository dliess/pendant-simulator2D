{% doc %}
  Interactive fluid pendant theme block. Settings are read from block.settings.
  @example
  Add Pendant simulator to an existing section that accepts @theme blocks.
{% enddoc %}

<pendant-simulator
  data-heading="{{ block.settings.heading | escape }}"
  data-show-heading="{{ block.settings.show_heading }}"
  data-display-width="{{ block.settings.display_width }}"
  data-particle-count="{{ block.settings.particle_count }}"
  data-fill-level="{{ block.settings.fill_level }}"
  data-gravity-strength="{{ block.settings.gravity_strength }}"
  {{ block.shopify_attributes }}
>
  <template data-pendant-simulator-assets>
    <link rel="stylesheet" href="{{ 'pendant-simulator.css' | asset_url }}">
    <script src="{{ 'pendant-simulator.js' | asset_url }}" defer></script>
  </template>
</pendant-simulator>

{% javascript %}
  // Shopify delivers this hook once per block file in its external block-scripts
  // bundle. Inert templates let repeated blocks share one real CSS/JS load.
  const loaderKey = Symbol.for('pendant-simulator.asset-loader');
  if (!window[loaderKey]) {
    window[loaderKey] = true;
    const loaded = new Set();

    function loadAssets(root) {
      const templates = root.matches?.('template[data-pendant-simulator-assets]')
        ? [root] : root.querySelectorAll('template[data-pendant-simulator-assets]');
      for (const template of templates) {
        for (const tag of template.content.querySelectorAll('link[href], script[src]')) {
          const isScript = tag.tagName === 'SCRIPT';
          const attribute = isScript ? 'src' : 'href';
          const url = new URL(tag.getAttribute(attribute), document.baseURI).href;
          const key = `${tag.tagName}:${url}`;
          if (loaded.has(key)) continue;
          loaded.add(key);
          const existing = Array.from(document.head.querySelectorAll(isScript ? 'script[src]' : 'link[rel="stylesheet"]'))
            .some(asset => asset[attribute] === url);
          if (existing) continue;
          const asset = document.createElement(isScript ? 'script' : 'link');
          asset[attribute] = url;
          asset.dataset.pendantSimulatorAsset = isScript ? 'script' : 'style';
          if (isScript) asset.defer = true;
          else asset.rel = 'stylesheet';
          asset.addEventListener('error', () => { loaded.delete(key); asset.remove(); }, { once: true });
          document.head.append(asset);
        }
      }
    }

    loadAssets(document);
    new MutationObserver(records => {
      for (const record of records) {
        for (const node of record.addedNodes) {
          if (node instanceof Element) loadAssets(node);
        }
      }
    }).observe(document.documentElement, { childList: true, subtree: true });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Pendant simulator",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try the pendant"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "range",
      "id": "display_width",
      "label": "Maximum display width",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "fill_level",
      "label": "Initial fill height",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "particle_count",
      "label": "Particle count",
      "min": 500,
      "max": 3000,
      "step": 500,
      "default": 2000,
      "info": "Lower counts reduce simulation work on mobile devices."
    },
    {
      "type": "range",
      "id": "gravity_strength",
      "label": "Gravity strength",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 14
    }
  ],
  "presets": [{ "name": "Pendant simulator" }]
}
{% endschema %}
